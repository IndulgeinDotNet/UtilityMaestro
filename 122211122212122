                url, payload_desc = url_entry.get(), payload_combo.get()
                if not url or not payload_desc:
                    output.insert(tk.END, "Please enter URL and select payload!\n", "error")
                    return
                payload = next(p["payload"] for p in SQL_PAYLOADS if p["desc"] == payload_desc)
                output.delete(1.0, tk.END)
                output.insert(tk.END, f"Injecting SQL into {url}...\n", "info")
