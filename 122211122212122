    def process_packet(self, packet, output):
        """Process and display each captured packet."""
        if IP in packet:
            src_ip = packet[IP].src
            dst_ip = packet[IP].dst
            proto = packet[IP].proto
            protocol = "TCP" if proto == 6 else "UDP" if proto == 17 else "Other"
            payload = packet.payload if Raw in packet else "No payload"
            output.insert(tk.END, f"Packet: {src_ip} -> {dst_ip} ({protocol})\n", "info")
            if Raw in packet:
                output.insert(tk.END, f"Payload: {bytes(packet[Raw]).decode(errors='ignore')[:50]}\n", "info")
            output.insert(tk.END, "-" * 50 + "\n", "success")

