        def prompt_save(self, content, prefix):
            """Prompt to save tool output."""
            if messagebox.askyesno("Save Results", "Would you like to save the output?"):
                filename = f"{prefix}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
                with open(filename, "w") as f:
                    f.write(content)
                self.log(f"Saved output to {filename}")

